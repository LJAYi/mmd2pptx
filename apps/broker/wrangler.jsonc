{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mmd2pptx-github-broker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://ljayi.github.io",
    "GITHUB_API_BASE_URL": "https://api.github.com",
    "GITHUB_OAUTH_BASE_URL": "https://github.com"
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "SESSION_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OAUTH_TRANSACTIONS",
        "class_name": "OAuthTransactionObject"
      },
      {
        "name": "AUTH_SESSIONS",
        "class_name": "AuthSessionObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OAuthTransactionObject", "AuthSessionObject"]
    }
  ]
}
