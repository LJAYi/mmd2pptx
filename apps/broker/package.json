{
  "name": "@mmd2pptx/github-broker",
  "version": "0.2.4",
  "description": "Read-only GitHub App authentication broker for mmd2pptx.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "wrangler dev",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@cloudflare/workers-types": "5.20260801.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "4.118.0"
  },
  "engines": {
    "node": ">=22"
  }
}
